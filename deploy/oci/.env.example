# Copy to deploy/oci/.env on the OCI VM and replace every placeholder.
# Keep this file private. Generate random hex strings for the passwords/secrets.

API_DOMAIN=api.example.com
PRIVEXIS_FRONTEND_ORIGIN=https://privexis.vercel.app
PRIVEXIS_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
DATABASE_URL=postgresql+psycopg://privexis:replace-with-a-long-random-hex-password@db:5432/privexis
PRIVEXIS_MAX_UPLOAD_MB=15
PRIVEXIS_SCAN_SAMPLE_ROWS=500

# Set these in the Vercel project, not in the OCI backend environment:
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_SITE_URL=https://privexis.vercel.app
